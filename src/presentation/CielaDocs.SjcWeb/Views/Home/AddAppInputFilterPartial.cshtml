@{
    ViewData["Title"] = "Index";

}
<style>
    .select2-container--open {
        z-index: 99999999
    }
</style>

<form id="anyForm">
    <div class="modal-body form-horizontal">
        <div class="container-fluid">

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="cbInstitutionType">Орган на съдебна власт</label>
                        <select class="form-control" style="width:100%" id="cbInstitutionType">
                            <option>Избери... </option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="cbCourtType">Вид</label>
                        <select class="form-control" style="width:100%" id="cbCourtType">
                            <option>Избери... </option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-6">
                    <div class="form-group">
                        <label for="cbCourt">Отчетна единица</label>
                        <select class="form-control" style="width:100%" id="cbCourt">
                            <option>Избери... </option>
                        </select>
                    </div>
                </div>
                <div class="col-3">
                    <div class="form-group">
                        <label for="selectMonth">Към месец</label>
                        <div id="selectMonth" style="color:red;font-size:medium;"></div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="form-group">
                        <label for="selectYear">За година</label>
                        <div id="selectYear" style="color:red;font-size:medium;"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="spacer_10"></div>
        <div style="float:right;margin-right:10px;margin-bottom:10px;">
            <div id="okInputBtn"></div>
            <div id="closeInputBtn"></div>
        </div>
    </div>
</form>
<script>
   
    $(() => {
         let institutionTypeId = 0;
        let courtTypeId = 0;
        let courtId = 0;
        let ny =Number('@ViewBag.Year')||0;
        let nm = Number('@ViewBag.Month')||0;

        $('#selectYear').text(ny);
         $('#selectMonth').text(nm);

         $("#cbInstitutionType").select2({
            placeholder: "Избери...",
            allowClear: true,
            ajax: {
                url: "@Url.Action("GetInstitutionTypes", "Noms")",
                contentType: "application/json; charset=utf-8",
                data: function (params) {
                    var query =
                    {
                        term: params.term,
                    };
                    return query;
                },
                processResults: function (result) {
                    return {
                        results: $.map(result, function (item) {
                            return {
                                id: item.Id,
                                text: item.Name

                            };

                        }),

                    };

                }
            }
        }).on('change', function (e) {
            institutionTypeId = $(e.currentTarget).val();
        });
        $("#cbCourtType").select2({
            placeholder: "Избери...",
            allowClear: true,
            ajax: {
                url: "@Url.Action("GetCourtTypesbyInstitutionTypeId", "Noms")",
                contentType: "application/json; charset=utf-8",
                data: function (params) {
                    var query =
                    {
                        institutionTypeId: institutionTypeId,
                        term: params.term,
                    };
                    return query;
                },
                processResults: function (result) {
                    return {
                        results: $.map(result, function (item) {
                            return {
                                id: item.Id,
                                text: item.Name

                            };

                        }),

                    };

                }
            }
        }).on('change', function (e) {
            courtTypeId=$(e.currentTarget).val();
        });
        $("#cbCourt").select2({
            placeholder: "Избери...",
            allowClear: true,
            ajax: {
                url: "@Url.Action("GetCourtsByCourtTypeIdSelect2", "Noms")",
                contentType: "application/json; charset=utf-8",
                data: function (params) {
                    var query =
                    {
                        courtTypeId: courtTypeId,
                        term: params.term,
                    };
                    return query;
                },
                processResults: function (result) {
                    return {
                        results: $.map(result, function (item) {
                            return {
                                id: item.Id,
                                text: item.Name

                            };

                        }),

                    };

                }
            }
        }).on('change', function (e) {
            courtId=$(e.currentTarget).val();
        });
         //-------------buttons--------------
        $('#okInputBtn').dxButton({
            stylingMode: 'contained',
            text: 'Добре',
            type: 'normal',
            width: 120,
            onClick() {
                if (courtId == 0)  {
                    DevExpress.ui.dialog.alert('Изберете задължително отчетна единица', 'Внимание');
                    return;
                }
                window.parent.OnClosePopupEventHandlerEx('appInputFilterOk', ''.concat(courtId, "|",nm, "|", ny));
            },
        });
        $('#closeInputBtn').dxButton({
            stylingMode: 'contained',
            text: 'Затвори',
            type: 'normal',
            width: 120,
            onClick() {
                popup.hide();
            },
        });
      
    });
     
</script>