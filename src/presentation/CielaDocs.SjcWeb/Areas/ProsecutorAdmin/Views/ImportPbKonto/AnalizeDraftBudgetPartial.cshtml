@using System.Linq
@{

    ViewBag.Title = "AnalizeMAinData";
    Layout = null;
}
@{
    ViewData["Title"] = "Index";

}

<div class="spacer_10"></div>
<div class="header-container">
    <h6 style="margin: 0;">Анализ за въведени данни за проектобюджет от Конто на:@ViewBag.ImportTypeName</h6>
</div>
@if (ViewBag.ImportTypeId == 0)
{
    <p> за: @ViewBag.CourtTypeName, Програма:@ViewBag.FunctionalSubAreaName, за година:@ViewBag.Ny </p>
}
else
{
    <p> за: @ViewBag.InstitutionTypeIName, Програма:@ViewBag.FunctionalSubAreaName, за година:@ViewBag.Ny </p>
}
<div class="spacer_5"></div>
<div id="typeOfResultFilter" style="width:180px;display:inline-block;padding-left:5px;"></div>
<div style="display:inline-block;padding-left:10px;" id="menu1"></div>
<div class="spacer_5"></div>
<div id="image-indicator"></div>
<div id="gridDraftBudget"></div>
<div class="spacer_10"></div>
<script>


        $('#image-indicator').dxLoadIndicator({
            indicatorSrc: "@Url.Content("~/images/ajax_loader.gif")",
        });

    $(()=>{
         let selectedtypeOfResultId;

         let loadIndicator;

       loadIndicator = $('#image-indicator').dxLoadIndicator({
                visible: false,
            }).dxLoadIndicator('instance');
            loadIndicator.option('visible', false);

            $('#typeOfResultFilter').dxSelectBox({
                dataSource: selectBoxResultTypeData,
                value: 0,
                valueExpr: 'id',
                displayExpr: 'name',
                label: "Вид резултат",
                labelMode: "floating",
                stylingMode:"underlined",
                onValueChanged(data) {
                    selectedtypeOfResultId = data.value;
                    $("#gridDraftBudget").dxDataGrid("instance").refresh();
                },
            });
            
        $('#gridDraftBudget').dxDataGrid({
            dataSource: new DevExpress.data.DataSource({
                store: new DevExpress.data.CustomStore({
                    key: 'Id',
                    load() {
                        return sendRequest(Ciela.baseUrl + "Noms/ShowDraftBudgetAnalize", 'Get', {typeOfResultId: selectedtypeOfResultId??0,
                            importTypeId:Number(@ViewBag.ImportTypeId),
                            courtTypeId:Number(@ViewBag.CourtTypeId),
                            institutionTypeId:Number(@ViewBag.InstitutionTypeId),
                            ny:Number(@ViewBag.Ny),
                           functionalSubAreaId:Number(@ViewBag.FunctionalSubAreaId)
                        });
                    }
                }),
            }),
            paging: {
                pageSize: 10,
            },
            selection: {
                mode: "single"
            },
            showBorders: true,
            showRowLines: true,
            columns: [
                { dataField: 'Name', caption: 'Отчетна единица', width: "80%" },

            ],

            focusedRowEnabled: true,

        });
         const menuData1 = [
            {
                id: '1',
                name: 'Експорт',
                icon: Ciela.rootUrl+'images/exporter.svg',


            }];
        const dxMenu1 = $('#menu1').dxMenu({
            dataSource: menuData1,
            hideSubmenuOnMouseLeave: false,
            displayExpr: 'name',
            onItemClick(data) {
                const item = data.itemData;
                if (item.id) {

                    switch (item.id) {


                        case '1':
                            var workbook = new ExcelJS.Workbook();
                            var worksheet = workbook.addWorksheet("DraftBudgetData");

                            DevExpress.excelExporter.exportDataGrid({
                                component: $("#gridDraftBudget").dxDataGrid("instance"),
                                worksheet: worksheet
                            }).then(function () {
                                workbook.xlsx.writeBuffer().then(function (buffer) {
                                    saveAs(new Blob([buffer], { type: "application/octet-stream" }), "DraftBudget.xlsx");
                                });
                            });
                            break;
                    }
                }
            },
        }).dxMenu('instance');

        const showSubmenuModes = [{
            name: 'onHover',
            delay: { show: 0, hide: 500 },
        }, {
            name: 'onClick',
            delay: { show: 0, hide: 300 },
        }];
    });
</script>