@{
    ViewData["Title"] = "Index";

}
<style>
    .select2-container--open {
        z-index: 99999999
    }
</style>
<form id="anyForm">
    <div class="modal-body form-horizontal">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label for="cbFunctionalArea">Функционална област</label>
                        <select class="form-control" style="width:100%" id="cbFunctionalArea">
                            <option>Избери... </option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label for="cbFunctionalSubArea">Бюджетна програма</label>
                        <select class="form-control" style="width:100%" id="cbFunctionalSubArea">
                            <option>Избери... </option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-4">
                    <div class="form-group">
                        <label for="nyear">За година</label>
                        <div id="selectBoxYear"></div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group">
                        <label for="cbCurrency">Валута</label>
                        <select class="form-control" style="width:100%" id="cbCurrency">
                            <option>Избери... </option>
                        </select>
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group">
                        <label for="cbCurrencyMeasure">Единица</label>
                        <select class="form-control" style="width:100%" id="cbCurrencyMeasure">
                            <option>Избери... </option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="lock-container">
                        <input type="text" readonly id="lock-result">
                    </div>
                </div>
            </div>
        </div>
        <div class="spacer_10"></div>
        <div style="float:right;margin-right:10px;margin-bottom:10px;">
            <div id="dxContextMenu"></div>
            <div id="btnLock"></div>
            <div id="btnLockedView"></div>
            <div id="okFilterBtn"></div>
            <div id="closeFilterBtn"></div>
        </div>
    </div>
</form>
<script>
    $(() => {
        let functionalAreaId = 0;
        let functionalSubAreaId = 0;
        let ny = 0;
        let currencyId = 0;
        let currencyMeasureId = 0;

             const buttonView = $("#btnLockedView").dxButton({
        visible: true,
        icon:Ciela.baseUrl+'images/lock-closed.svg',
        hint:'Заключени периоди',
        onClick: function () {
                mainRightReadOnlyPopup.option({
                contentTemplate: () => layoutPopupContentTemplateByName(Ciela.baseUrl + "Home/AddApprovedDataItemLockedPartial", { }),
                height: $(window).height() - 150,
                width: $(window).width() - 800,
                title: 'Заключени периоди',
            });
            mainRightReadOnlyPopup.show();
        }
        }).dxButton("instance");

        let isLocked=false;
        $('#lock-result').val('');
        $('#lock-result').addClass("hideme")
        const contextMenu = $("#dxContextMenu").dxContextMenu({
        dataSource: [
            {id:1, text: "Заключи периода" },
            {id:2, text: "Отключи периода" }
        ],
        target: "#btnLock",
        visible: false,
        onItemClick: function (e) {

               switch (e.itemData.id) {
                    case 1:
                            var result = DevExpress.ui.dialog.confirm("<i>Потвърдете заключването на периода?</i>", "Потвърждение");
                             result.done(function (dialogResult) {
                                 if (dialogResult === true) {
                                     $.ajax({
                                         url: Ciela.baseUrl + "Noms/LockApprovedDataItem", data: {typeoflock:0, programId: functionalSubAreaId, ny: ny }, method: 'POST'
                                     })
                                         .done(function (result) {
                                             DevExpress.ui.notify(result.msg);
                                         })
                                         .fail(function () {
                                             DevExpress.ui.notify('Грешка при заключване на период.');
                                         });
                                 }
                             });
                        break;
                    case 2:
                       var result = DevExpress.ui.dialog.confirm("<i>Потвърдете отключването на периода?</i>", "Потвърждение");
                             result.done(function (dialogResult) {
                                 if (dialogResult === true) {
                                     $.ajax({
                                         url: Ciela.baseUrl + "Noms/LockApprovedDataItem", data: {typeoflock:1, programId: functionalSubAreaId, ny: ny }, method: 'POST'
                                     })
                                         .done(function (result) {
                                             DevExpress.ui.notify(result.msg);
                                         })
                                         .fail(function () {
                                             DevExpress.ui.notify('Грешка при заключване на период.');
                                         });
                                 }
                             });
                        break;

                }
             }
         }).dxContextMenu("instance");


        const button = $("#btnLock").dxButton({
        visible: false, // Initially hidden
        onClick: function (e) {
           contextMenu.show(e.event);
        }
        }).dxButton("instance");


            function toggleButtonVisibility(condition) {
                button.option('visible', condition);
                button.option('icon',Ciela.baseUrl+'images/lock-open.svg')
            }

    // Initialize the Context Menu
        $("#selectBoxYear").dxSelectBox({
            dataSource: selectBoxYearData,
            valueExpr: 'id',
            displayExpr: 'name',
            onValueChanged: function (e) {
                ny = e.value;
                nSelectedYear=ny;
            }

        });
        $.ajax({
            url: "@Url.Action("GetCurrencyById", "Noms")",
            dataType: 'json',
            type: "Get",
            data: { id: currencyId },
            success: function (data) {
                $("#cbCurrency").empty();
                $("#cbCurrency").append("<option value='-1'>--Избери--</option>");
                $("#cbCurrency").append("<option value='" + data.Id + "'>" + data.Name + "</option>");
                $('#cbCurrency').val(currencyId);
            }
        });
        $.ajax({
            url: "@Url.Action("GetCurrencyMeasureById", "Noms")",
            dataType: 'json',
            type: "Get",
            data: { id: currencyMeasureId },
            success: function (data) {
                $("#cbCurrencyMeasure").empty();
                $("#cbCurrencyMeasure").append("<option value='-1'>--Избери--</option>");
                $("#cbCurrencyMeasure").append("<option value='" + data.Id + "'>" + data.Name + "</option>");
                $('#cbCurrencyMeasure').val(currencyMeasureId);
            }
        });
        $("#cbFunctionalArea").select2({
            placeholder: "Избери...",
            allowClear: true,
            ajax: {
                url: "@Url.Action("GetFunctionalAreas", "Noms")",
                contentType: "application/json; charset=utf-8",
                data: function (params) {
                    var query =
                    {
                        term: params.term,
                    };
                    return query;
                },
                processResults: function (result) {
                    return {
                        results: $.map(result, function (item) {
                            return {
                                id: item.Id,
                                text: item.Name

                            };

                        }),

                    };

                }
            }
        }).on('change', function (e) {
            functionalAreaId = $(e.currentTarget).val();
        });
        $("#cbFunctionalSubArea").select2({
            placeholder: "Избери...",
            allowClear: true,
            ajax: {
                url: "@Url.Action("GetFunctionalSubAreaByAreaId", "Noms")",
                contentType: "application/json; charset=utf-8",
                data: function (params) {
                    var query =
                    {
                        id: functionalAreaId,
                        term: params.term,
                    };
                    return query;
                },
                processResults: function (result) {
                    return {
                        results: $.map(result, function (item) {
                            return {
                                id: item.Id,
                                text: item.Name

                            };

                        }),

                    };

                }
            }
        }).on('change', function (e) {
            functionalSubAreaId = $(e.currentTarget).val();
        });
        $("#cbCurrency").select2({
            placeholder: "Избери...",
            allowClear: true,
            ajax: {
                url: "@Url.Action("GetCurrencies", "Noms")",
                contentType: "application/json; charset=utf-8",
                data: function (params) {
                    var query =
                    {
                        term: params.term,
                    };
                    return query;
                },
                processResults: function (result) {
                    return {
                        results: $.map(result, function (item) {
                            return {
                                id: item.Id,
                                text: item.Name

                            };

                        }),

                    };

                }
            }
        }).on('change', function (e) {
            currencyId = $(e.currentTarget).val();
        });
        $("#cbCurrencyMeasure").select2({
            placeholder: "Избери...",
            allowClear: true,
            ajax: {
                url: "@Url.Action("GetCurrencyMeasure", "Noms")",
                contentType: "application/json; charset=utf-8",
                data: function (params) {
                    var query =
                    {
                        term: params.term,
                    };
                    return query;
                },
                processResults: function (result) {
                    return {
                        results: $.map(result, function (item) {
                            return {
                                id: item.Id,
                                text: item.Name

                            };

                        }),

                    };

                }
            }
        }).on('change', function (e) {
            currencyMeasureId = $(e.currentTarget).val();
        });
       //  ---------get dynamic action if selected two evalues
       const dropdowns = [
        { type: 'select2', element: $('#cbFunctionalSubArea') },
        { type: 'dxDropDown', element: $('#selectBoxYear').dxSelectBox('instance') }
    ];

        dropdowns.forEach(dropdown => {
        if (dropdown.type === 'select2') {
            dropdown.element.on('change', checkAllSelected);
        } else if (dropdown.type === 'dxDropDown') {
            dropdown.element.option('onValueChanged', checkAllSelected);
        } else {
            dropdown.element.addEventListener('change', checkAllSelected);
        }
    });

    function getValue(dropdown) {
        if (dropdown.type === 'select2') {
            return dropdown.element.val();
        } else if (dropdown.type === 'dxDropDown') {
            return dropdown.element.option('value');
        } else {
            return dropdown.element.value;
        }
    }

    async function  checkAllSelected() {
        const allSelected = dropdowns.every(d => {
            const value = getValue(d);
            return value !== null && value !== undefined && value !== '';
        });

        if (allSelected) {
           // console.log('All dropdowns have selected values!');
           ny=$("#selectBoxYear").dxSelectBox("option", "value");
           nSelectedYear=ny;
            // Trigger your custom logic here
            let res=await fetchDataAsync(Ciela.baseUrl + "Noms/CheckPeriod5Locked", { programId: functionalSubAreaId, ny: ny })
             .then(data =>{
                if(!isEmpty(data)){
                    $('#lock-result').val('Заключен период от '+data?.LockedByUserName);
                    $('#lock-result').removeClass("hideme");
                    isLocked=true;
                }
                else {
                      $('#lock-result').val('');
                    $('#lock-result').addClass("hideme");
                    isLocked=false;
                }
             });

            toggleButtonVisibility(true);
        }
    }
        //-------------buttons--------------
        $('#okFilterBtn').dxButton({
            stylingMode: 'contained',
            text: 'Добре',
            type: 'normal',
            width: 120,
            onClick() {
                if ((functionalSubAreaId == 0) || (ny == 0)) {
                    DevExpress.ui.dialog.alert('Изберете задължително бюджетна програма и година', 'Внимание');
                    return;
                }
                window.parent.OnClosePopupEventHandlerEx('approvedDataFilterOk', ''.concat(functionalSubAreaId, "|", ny, "|", currencyId, "|", currencyMeasureId,"|",isLocked));
            },
        });
        $('#closeFilterBtn').dxButton({
            stylingMode: 'contained',
            text: 'Затвори',
            type: 'normal',
            width: 120,
            onClick() {
                popup.hide();
            },
        });
    });

</script>