@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery antiforgery
@{
    var tokenSet = antiforgery.GetAndStoreTokens(Context);
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="spacer_20"></div>
<h3>Администриране и конфигуриране на системата. Бюджетни периоди,Официална Валута:@ViewBag.OfficialCurrencyCode</h3>
<div class="spacer_5"></div>
<div class="container-flex">
    <input type="text" readonly id="activeperiodparams" class="lock-result">
</div>
<div style="display:inline-block;padding-left:10px;" id="menu"></div>
<div class="spacer_5"></div>
<div id="image-indicator"></div>
<div id="grid"></div>
<script>
    $('#image-indicator').dxLoadIndicator({
        indicatorSrc: "@Url.Content("~/images/ajax_loader.gif")",
    });
    $(() => {
        let selectedId = 0;
       let hasActivePeriod=0;
        loadIndicator = $('#image-indicator').dxLoadIndicator({
            visible: false,
        }).dxLoadIndicator('instance');
        loadIndicator.option('visible', false);
        
          let activePeriod= fetchDataAsync(EduDl.baseUrl + "Noms/GetActiveBudgetPeriod", { })
             .then(data =>{
                if(!isEmpty(data)){
                    hasActivePeriod=data?.Y1 ? Number(data?.Y1) :0;
                    $('#activeperiodparams').val('Активен период: '+`${data?.Y1},${data?.Y2},${data?.Y3} и ${data?.Y4}`);
                }
                else {
                      $('#activeperiodparams').val('');
                }
             });
        $('#grid').dxDataGrid({
                dataSource: new DevExpress.data.DataSource({
                    store: new DevExpress.data.CustomStore({
                        key: 'Id',
                        load() {
                            return sendRequest(EduDl.baseUrl + "Home/GetBudgetPeriods", 'Get', { });
                        }
                    }),
                }),
                paging: {
                    pageSize: 10,
                },
                pager: {
                    visible: true,
                    showNavigationButtons: true,
                    allowedPageSizes: [10, 25, 50, 100],
                    showPageSizeSelector: true,
                    showInfo: true,
                    showNavigationButtons: true,
                },
                searchPanel: {
                    visible: true,
                    highlightCaseSensitive: true,
                },
                selection: {
                    mode: "single"
                },
                showBorders: true,
                showRowLines: true,
                columns: [

                    {
                        dataField: "Y1",
                        width: "10%",
                        caption: "Активна година"
                    },
                    {
                        dataField: "Y2",
                        width: "10%",
                        caption: "година"
                    },
                     {
                        dataField: "Y3",
                        width: "10%",
                        caption: "година"
                    },
                     {
                        dataField: "Y4",
                        width: "10%",
                        caption: "година"
                    },
                    {
                        dataField: "IsActive",
                        caption: "Активен",
                        dataType: "boolean",
                        lookup: {
                            dataSource: [
                                { value: true, text: "ДА" },
                                { value: false, text: "НЕ" }
                            ],
                            valueExpr: "value",
                            displayExpr: "text"
                        }
                    },
                    {
                        dataField: "ActiveFrom",
                        width: "10%",
                        caption: "Активен от",
                        alllowEditing: false,
                        valueFormat: 'dd.MM.yyyy',
                        dataType: 'date',
                        format: {
                            formatter: function (value) {
                                return value.toLocaleString('bg-BG');
                            }
                        }

                    },
                    {
                       dataField: "ActiveTo",
                        width: "10%",
                        caption: "Активен до",
                        alllowEditing: false,
                        valueFormat: 'dd.MM.yyyy',
                        dataType: 'date',
                        format: {
                            formatter: function (value) {
                                return value.toLocaleString('bg-BG');
                            }
                        }

                    },

                    {
                        dataField: "Note",
                        width: "20%",
                        caption: "Забележка"
                    },
                    {
                        type: 'buttons',
                        width: 96,
                        buttons: [{
                            hint: 'Приключване',
                            icon: 'edit',

                            onClick(e) {
                                endActivePeriod(e.row.data.Id)
                                e.component.refresh(true);
                                e.event.preventDefault();
                            },
                        }
                        ],
                    }
                ],

                onRowRemoved: function (e) {
                    e.component.selectRowsByIndexes(0);
                },
                onSelectionChanged: function (items) {
                    if (items.selectedRowsData[0]) {
                        selectedId = items.selectedRowsData[0].Id;
                    }
                },
                focusedRowEnabled: true,
                onFocusedRowChanged(e) {
                    if (e) {
                       // getExtraDataItem(e.row);
                    }
                },
            });

              const menuData = [{
            id: '1',
            name: 'Добави',
            icon: EduDl.rootUrl+'images/add.png',


        },{
            id: '2',
            name: 'Текуща бюджетна година',
            icon: EduDl.rootUrl+'images/add.png',


        },{
            id: '3',
            name: 'Текущ месец за входни данни',
            icon: EduDl.rootUrl+'images/add.png',


        }
           ];
        const dxMenu = $('#menu').dxMenu({
            dataSource: menuData,
            hideSubmenuOnMouseLeave: false,
            displayExpr: 'name',
            onItemClick(data) {
                const item = data.itemData;
                if (item.id) {

                    switch (item.id) {

                          case '1':
                           addNewBudgetPeriod();
                            break;
                          case '2':
                           addNewCurrentYear();
                            break;
                         case '3':
                           addNewCurrentAppMonth();
                            break;
                       
                    }
                }
            },
        }).dxMenu('instance');

        const showSubmenuModes = [{
            name: 'onHover',
            delay: { show: 0, hide: 500 },
        }, {
            name: 'onClick',
            delay: { show: 0, hide: 300 },
        }];


         function  addNewBudgetPeriod(){
             if(hasActivePeriod>0){
                 DevExpress.ui.dialog.alert(`Има вече текущ активен период ${hasActivePeriod}! Приключете го за да добавите нов активен период.`); return;
             }
              mainPopup.option({
                contentTemplate: () => layoutPopupContentTemplateByName(EduDl.baseUrl + "Home/AddBudgetPeriodPartial", { }),
                height: 400,
                width: 600,
                title: 'Нов Бюджетен активен период',
            });
            mainPopup.show();
        }
        function endActivePeriod(id){
             let activePeriod= fetchDataAsync(EduDl.baseUrl + "Noms/GetActiveBudgetPeriodById", {id:id })
             .then(data =>{
                if(!isEmpty(data)){
                    hasActivePeriod=data?.IsActive ? Boolean(data?.IsActive) :false;
                    console.log(hasActivePeriod);
                   if(hasActivePeriod==false){
                        DevExpress.ui.dialog.alert(`Избраният от Вас период не е активен. Селектирайте реда с активен период и кликнете върху линк Приключване`); return;
                   }
                   else{
                       endActiveBudgetPeriod(id);
                   }
                }
                else {
                     DevExpress.ui.dialog.alert(`Не бе открит активен период за приключване. Селектирайте реда с активен период и кликнете върху линк Приключване`); return;
                }
             });
        }
        function endActiveBudgetPeriod(id){
              var result = DevExpress.ui.dialog.confirm("Потвърдете Приключването на избрания активен бюджетен период? Действието е необратимо!!! Ще бъдат занулени всички работни данни за периода. Добре е да имате изготвен архив на базата данни", "Потвърждение");
                             result.done(function (dialogResult) {
                                 if (dialogResult === true) {
                                       loadIndicator.option('visible', true);
                                     $.ajax({
                                         beforeSend: function (request) {
                                         request.setRequestHeader('@tokenSet.HeaderName', '@tokenSet.RequestToken')
                                         },
                                         url: EduDl.baseUrl + "Home/EndActivePeriodById", data: {id:id }, method: 'POST'
                                     })
                                         .done(function (result) {
                                              loadIndicator.option('visible', false);
                                              $("#grid").dxDataGrid("instance").refresh();
                                             DevExpress.ui.notify(result.msg);
                                         })
                                         .fail(function () {
                                              loadIndicator.option('visible', false);
                                             DevExpress.ui.notify('Грешка при приключване на период.');
                                         });
                                 }
                             });
        }
        function  addNewCurrentYear()
        {
            mainPopup.option({
                contentTemplate: () => layoutPopupContentTemplateByName(EduDl.baseUrl + "Home/AddCurrentYear", { }),
                height: 400,
                width: 600,
                title: 'Нова текуща бюджетна година',
            });
            mainPopup.show();
        }
         function addNewCurrentAppMonth()
        {
            mainPopup.option({
                contentTemplate: () => layoutPopupContentTemplateByName(EduDl.baseUrl + "Home/AddCurrentAppMonth", { }),
                height: 400,
                width: 600,
                title: 'Нова текущ месец за входни данни',
            });
            mainPopup.show();
        }
    });

       

        

</script>