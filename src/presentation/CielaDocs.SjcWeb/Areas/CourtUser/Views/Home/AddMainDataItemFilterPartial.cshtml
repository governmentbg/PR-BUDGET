@{
    ViewData["Title"] = "Index";

}

<style>
    .select2-container--open {
        z-index: 9999999
    }
</style>
<form id="anyForm">
    <div class="modal-body form-horizontal">

        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <div class="lock-container">
                            <input type="text" readonly id="aciveperiodparams" class="lock-result">
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-4">
                    <div class="form-group">
                        <label for="nmonth">За месец</label>
                        <div id="selectBoxMonth"></div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group">
                        <label for="nyear">За година</label>
                        <div id="selectBoxYear"></div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="lock-container">
                        <input type="text" readonly id="lock-result">
                    </div>
                </div>
            </div>
        </div>
        <div class="spacer_10"></div>
        <div style="float:right;margin-right:10px;margin-bottom:10px;">
            <div id="btnLockedView"></div>
        <div id="okFilterItemBtn"></div>
        <div id="closeFilterItemBtn"></div>
        </div>
    </div>
</form>
<script>
    $(() => {
        let nm = 0;
        let ny = 0;
         let isLocked=false;
        $('#lock-result').val('');
        $('#lock-result').addClass("hideme")

             const buttonView = $("#btnLockedView").dxButton({
        visible: true,
        icon:Ciela.rootUrl+'images/lock-closed.svg',
        hint:'Заключени периоди',
        onClick: function () {
                mainRightReadOnlyPopup.option({
                contentTemplate: () => layoutPopupContentTemplateByName(Ciela.baseUrl + "Home/AddMainDataItemLockedPartial", { }),
                height: $(window).height() - 150,
                width: $(window).width() - 800,
                title: 'Заключени периоди',
            });
            mainRightReadOnlyPopup.show();
        }
        }).dxButton("instance");

       checkData();
        $("#selectBoxMonth").dxSelectBox({
            dataSource: selectBoxMonthData,
            valueExpr: 'id',
            displayExpr: 'name',
            onValueChanged: function (e) {
                nm=e.value;
            }
           
        });
       $("#selectBoxYear").dxSelectBox({
            dataSource: new DevExpress.data.DataSource({
                store: new DevExpress.data.CustomStore({
                    key: 'Id',
                    load() {
                        return sendRequest(Ciela.baseUrl + "Noms/GetActivePeriodYear", 'Get', { });
                    }
                }),
            }),
            valueExpr: 'Id',
            displayExpr: 'Name',
            onValueChanged: function (e) {
               ny=e.value;
               nSelectedYear=ny;
            }

        });

              
        //-------------buttons--------------
        $('#okFilterItemBtn').dxButton({
            stylingMode: 'contained',
            text: 'Добре',
            type: 'normal',
            width: 120,
            onClick() {
                if ((nm==0)||(ny==0)) { 
                    DevExpress.ui.dialog.alert('Изберете задължително месец и година','Внимание');
                    return;
                }
                window.parent.OnClosePopupEventHandlerEx('mainDataItemFilterOk', ''.concat(nm, "|",nSelectedYear,"|",isLocked));
            },
        });
        $('#closeFilterItemBtn').dxButton({
            stylingMode: 'contained',
            text: 'Затвори',
            type: 'normal',
            width: 120,
            onClick() {
                popup.hide();
            },
        });
        async function checkData(){
            let activePeriod= fetchDataAsync(Ciela.baseUrl + "Noms/GetActiveBudgetPeriod", { })
             .then(data =>{
                if(!isEmpty(data)){
                    $('#aciveperiodparams').val('Активен период: '+`${data?.Y1},${data?.Y2},${data?.Y3} и ${data?.Y4}`);
                }
                else {
                      $('#aciveperiodparams').val('');
                }
             });
      // Trigger your custom logic here
                let res=await fetchDataAsync(Ciela.baseUrl + "Noms/CheckPeriod2Locked", { courtId: courtId,nm:nm, ny: ny })
                 .then(data =>{
                        if(!isEmpty(data)){
                        $('#lock-result').val('Заключен период от '+data?.LockedByUserName);
                        $('#lock-result').removeClass("hideme");
                        isLocked=true;
                    }
                    else {
                          $('#lock-result').val('');
                        $('#lock-result').addClass("hideme");
                        isLocked=false;
                    }
                 });
        }
    });
   
</script>