@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery antiforgery
@{
    var tokenSet = antiforgery.GetAndStoreTokens(Context);
    ViewData["Title"] = "Index";

}
<form id="anyForm">
  
    <div class="modal-body form-horizontal">

        <div class="container-fluid">

            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="ddlInstitutionType">орган на съдебна власт</label>
                        <select class="form-control" style="width:100%" id="ddlInstitutionType">
                            <option>Избери... </option>
                        </select>
                    </div>
                </div>
            </div>
            <div id="result"></div>
            <div class="spacer_10"></div>
            <div style="float:right;margin-right:10px;margin-bottom:10px;">
                <div id="okInstitutionTypeBtn"></div>
                <div id="closeInstitutionTypeBtn"></div>
            </div>
        </div>
    </div>
</form>
<script>
    $(() => {
        let appId=Number('@ViewBag.AppId')||0;
      let institutionTypeId=0;
       
        $("#ddlInstitutionType").select2({
            placeholder: "Избери...",
            allowClear: true,
            ajax: {
                url: "@Url.Action("GetInstitutionTypes", "Noms", new { area = "Admin" })",
                contentType: "application/json; charset=utf-8",
                data: function (params) {
                    var query =
                    {

                        term: params.term,
                    };
                    return query;
                },
                processResults: function (result) {
                    return {
                        results: $.map(result, function (item) {
                            return {
                                id: item.Id,
                                text: item.Name
                            };
                        }),
                    };
                }
            }
        }).on('change', function (e) {
           institutionTypeId=$(e.currentTarget).val();
        });
           $('#okInstitutionTypeBtn').dxButton({
            stylingMode: 'contained',
            text: 'Добре',
            type: 'normal',
            width: 120,
            onClick() {

                


            $.ajax({
                beforeSend: function (request) {
                    request.setRequestHeader('@tokenSet.HeaderName', '@tokenSet.RequestToken')
                },
                url: "@Url.Action("Save", "Apps", new { area = "Admin" })", method: 'POST', data: {appId:appId,institutionTypeId:institutionTypeId}

            })
                .done(function (result) {
                    $('#result').empty();
                    if (result.success === true) {
                        
                         $('#result').text(result.msg);
   
                    }
                    else {
                        $('#result').text(result.msg);
                    }

                })
                .fail(function (e) {
                    DevExpress.ui.notify('Failed to save! ' + e);
                });
            },
        });
        $('#closeInstitutionTypeBtn').dxButton({
            stylingMode: 'contained',
            text: 'Затвори',
            type: 'normal',
            width: 120,
            onClick() {
               mainPopup.hide();
            },
        });
    });
</script>